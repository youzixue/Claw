# 本地开发配置模板；复制为 backend/.env 后自行填写，绝不提交真实凭据。
# 本模板不覆盖策略、仓位、风控或模型晋级参数；其他配置沿用 settings.py。

APP_NAME=Claw
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./claw.db
REDIS_URL=redis://localhost:6379/0

# 可选问财登录凭据，只在本机填写。
PYWENCAI_COOKIE=

# 可选 AI 增强层，默认关闭。
AI_ENABLED=false
AI_BASE_URL=https://api.minimaxi.com/anthropic
AI_MODEL=MiniMax-M2.7
AI_API_KEY=

# 新环境默认不发送通知；需要时填写 webhook 并显式开启。
PUSH_ENABLED=false
FEISHU_WEBHOOK_URL=

# 空管理令牌保持模型晋级 / 回滚写接口关闭。
PROMOTION_GOVERNANCE_TOKEN=
