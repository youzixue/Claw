# Env —— 必须覆盖备份/变体：.env.bak-* 同样含凭据。
# 曾出现 .env.bak-20260917-0058（含问财登录 cookie）未被忽略的情况，
# 若被 `git add -A` 扫到即造成凭据入库。
.env
.env.*
!.env.example

# Node
node_modules/
frontend/dist/

# Logs and generated runtime market archives
*.log
logs/
# 运行数据整体忽略。runtime/wencai-profile 是 Playwright 持久化登录 profile，
# **含问财登录 cookie**，绝不能入库。
runtime/

# Coverage
htmlcov/
.coverage

# ── 2026-09-16 建立 git 基线时补全 ──────────────────────────────────────
# 原规则只写了 *.db / *.sqlite3，漏掉了同样属于「运行数据而非源码」的东西：
#   * SQLite 旁挂文件（WAL/SHM）：活库 claw.db-wal 曾达 80MB，绝不能入库
#   * *.sqlite：冻结复盘库 evidence.sqlite 有 803MB
#   * outputs/：复盘证据与演练产物，单次可达 GB 级，不属于源码基线
#   * 前端调试截图：tmp-*.png 累计十余 MB
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm
*.sqlite3-wal
*.sqlite3-shm

# 运行数据 / 证据 / 临时产物
outputs/
.tmp/
temp_test/
test-results/
.playwright-cli/
tmp/

# 调试截图
frontend/tmp-*.png
**/tmp-*.png
/*.png
kline-*.png
sectors_*.png

# 生成的缓存（非源码；.workbuddy/memory/ 等仍应入库）
.workbuddy/stock_list_cache.json
